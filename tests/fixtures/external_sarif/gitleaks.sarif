{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "gitleaks",
          "semanticVersion": "v8.0.0",
          "informationUri": "https://github.com/gitleaks/gitleaks",
          "rules": [
            {
              "id": "aws-access-key",
              "shortDescription": {
                "text": "AWS Access Key"
              }
            },
            {
              "id": "pypi",
              "shortDescription": {
                "text": "PyPI upload token"
              }
            }
          ]
        }
      },
      "results": [
        {
          "message": {
            "text": "Synthetic fixture result"
          },
          "ruleId": "test-rule",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "fixtures/synthetic.txt"
                },
                "region": {
                  "startLine": 1,
                  "startColumn": 1,
                  "endLine": 2,
                  "endColumn": 2
                }
              }
            }
          ],
          "properties": {
            "tags": [
              "tag1",
              "tag2",
              "tag3"
            ]
          }
        }
      ]
    }
  ]
}
